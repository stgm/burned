<p class="lead">Sign in with your email address. We mail you a code. No passwords.</p>
<form action="/login" method="post" class="stack">
  <%= csrf_field %>
  <label for="email">Email</label>
  <input id="email" name="email" type="email" autocomplete="email" inputmode="email" autofocus required>
  <button type="submit" class="primary">Send me a code</button>
</form>
